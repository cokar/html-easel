{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "html-easel",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",

  "observability": {
    "enabled": true
  },

  // 管理后台的静态文件由 Worker 自己托管，不需要 Cloudflare Pages。
  // run_worker_first = true 让所有请求先进 Worker，由 Worker 决定是分发项目还是返回界面。
  // 后台文件在 public/admin/ 下，URL 路径 /admin/* 与之一一对应。
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // 解压后的文件按 "<项目名>/<路径>" 存进这个桶；元数据也在这个桶里（__sites.json / __config.json）。
  // 注意：R2 桶名在全球范围内唯一，如果 "html-easel" 被占用请换一个名字并同步修改这里。
  // 也可以直接跑 `npm run setup`，向导会自动建桶并把名字写到这里。
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "html-easel"
    }
  ],

  "vars": {
    // ⚠️ 改成你自己的、已托管在 Cloudflare 的域名。
    // 唯一的路由 *.<ROOT_DOMAIN>/* 会从这里自动推导，所以你只需要改这一处：
    //   www.<域名>   入口页在 /，管理后台在 /admin
    //   <项目>.<域名> 项目的静态页面
    "ROOT_DOMAIN": "example.com",

    // 入口页上显示的标题和副标题
    "SITE_TITLE": "我的网页收藏",
    "SITE_DESCRIPTION": "这里托管着我收集的静态页面，点开任意一个都能直接浏览。",

    // 想让裸域名（不带 www）也能访问时改成 true：
    // 部署脚本会额外生成 <域名>/* 路由（访问时 302 到 www），
    // 你还需要在 DNS 里加一条 @ 的 A 记录（橙云）。默认 false，只需一条通配记录。
    "ENABLE_APEX": false
  }

  // 注意：这里故意不写 routes。
  // 一旦配置里存在 routes，`wrangler dev` 会把所有请求的 Host 重写成路由域名，
  // 本地就没法用 myproj.localhost 测试子域名分发了。
  // 部署用的路由由 `npm run deploy` 生成到 wrangler.deploy.jsonc，见那个脚本里的说明。
}
